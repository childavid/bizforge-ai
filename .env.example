# App database. Use a persistent disk location in production.
# BIZFORGE_DB_PATH=/home/your-user/bizforge/saas.db

# Public URL of the Flask payment API. Leave blank when payments are disabled.
BACKEND_URL=https://your-domain.example

# Free, private local AI for email, social-post, and business-idea drafts.
# Install Ollama, run `ollama pull llama3.2`, then leave these values as shown.
# Set BIZFORGE_AI_PROVIDER=disabled to always use the built-in smart drafts.
BIZFORGE_AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://127.0.0.1:11434/api/generate

# Do not enable payments until the webhook has passed a successful test payment.
PAYMENTS_ENABLED=false
PRO_PRICE_NGN=5000

# Set these only in your private server environment or private .env file.
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=

# Owner notifications. Gmail requires a 16-character App Password when
# 2-Step Verification is enabled; never use your normal Gmail password here.
NOTIFICATION_RECIPIENT=childavid558@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=childavid558@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=childavid558@gmail.com

# Public app-integration webhook. Generate a long random value and share it
# only with the services that should be allowed to call /app-webhook.
APP_WEBHOOK_SECRET=
